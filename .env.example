# ==============================================================================
#  AUTOESCOLA HABILITAR — LANDING PAGE + MINI CRM DE LEADS
# ==============================================================================
#  Stack .........: React 18 + Vite 5 + Tailwind CSS (deploy: Vercel)
#
#  COMO USAR ESTE ARQUIVO
#    1. Copie este arquivo:  cp .env.example .env   (Windows: copy)
#    2. Preencha os valores vazios com as credenciais reais.
#    3. NUNCA commitar o .env real — ele contém segredos e já está no
#       .gitignore. Este .env.example é a única versão versionável, sempre
#       SEM valores sensíveis.
#    4. Produção: replique estas variáveis no Vercel Dashboard
#       (Settings → Environment Variables) para Production e Preview.
#
#  ⚠️ CONVENÇÃO DE PREFIXOS — LEIA ANTES DE ADICIONAR VARIÁVEIS
#    Este projeto usa Vite. Por padrão o Vite SÓ injeta no bundle variáveis
#    com prefixo "VITE_", mas o vite.config.js está configurado com
#    envPrefix: ['VITE_', 'PUBLIC_'], então variáveis "PUBLIC_*" TAMBÉM são
#    lidas via import.meta.env (mesma convenção do alexdonega-website/Astro).
# ==============================================================================


# --- Banco de Dados / Backend (Supabase) ---
# Captura de leads (tabela "leads") com metadados completos — UTMs, página de
# origem, referrer e dispositivo — no submit do formulário de pré-matrícula
# (src/lib/supabase.js + src/lib/leadCapture.js + src/App.jsx).

# Finalidade : URL base do projeto Supabase (endpoint das APIs REST/Realtime).
# Padrão     : sem valor → integração Supabase fica inoperante (sem fallback).
# Onde obter : https://supabase.com/dashboard → seu projeto →
#              Project Settings → API → "Project URL".
PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co


# --- Autenticação (Chaves de API Supabase) ---

# Finalidade : Chave pública (anon) para chamadas client-side; respeita as
#              Row Level Security (RLS) configuradas no banco.
# Segurança  : Por design é exposta ao navegador — NÃO é segredo. A proteção
#              real vem das políticas RLS das tabelas.
# Onde obter : Dashboard Supabase → Project Settings → API →
#              "Project API keys" → anon / public.
PUBLIC_SUPABASE_ANON_KEY=

# Finalidade : Duplicata legada da anon key (nome informal do dashboard).
#              Mantida por compatibilidade histórica; em código novo use
#              PUBLIC_SUPABASE_ANON_KEY.
API_Keys_public=

# Finalidade : Chave de serviço (service_role) — bypassa TODAS as políticas
#              RLS e tem acesso total ao banco. Uso exclusivo server-side
#              (API routes, Edge/Serverless Functions, scripts).
# Segurança  : 🚨 SEGREDO DE ALTO RISCO. NUNCA usar no client nem commitar.
#              Se vazar, rotacione imediatamente no dashboard.
# Onde obter : Dashboard Supabase → Project Settings → API → service_role
#              (clique em "Reveal" para visualizar).
service_role=


# --- Marketing / Observabilidade (Google Tag Manager) ---

# Finalidade : ID do container GTM para gerenciar tags de analytics/marketing
#              sem alterar código (GA4, Meta, etc.).
# Padrão     : vazio → feature DESATIVADA (não há script GTM no index.html;
#              hoje o único rastreamento é o Facebook Pixel, hardcoded).
# Formato    : GTM-XXXXXXX (ex.: GTM-ABC1234).
# Onde obter : https://tagmanager.google.com → seu container → o ID aparece
#              no topo da tela. Requer conta Google com acesso ao container.
PUBLIC_GTM_ID=


# --- Configurações da Aplicação (Contato / WhatsApp) ---

# Finalidade : WhatsApp comercial usado no botão flutuante de contato
#              (link wa.me) da landing page.
# Formato    : apenas dígitos, em DDI + DDD + número
#              (ex.: 55 66 99630-260 → 556699630260).
# Observação : hoje o app usa o número hardcoded em src/App.jsx; esta
#              variável é a fonte declarativa para quando o valor passar a
#              ser lido do ambiente.
PUBLIC_WHATSAPP_NUMBER=556699630260


# --- IA Generativa (Z.ai — AE Studio em /studio) ---
# Funções serverless em api/ geram imagens (GLM-Image) e vídeos (CogVideoX-3)
# chamando a API da Z.ai. Sem prefixo VITE_/PUBLIC_ = nunca vão para o bundle.

# Finalidade : Chave da API da Z.ai usada pelas funções /api/create-image,
#              /api/create-video e /api/task-status (Authorization Bearer).
# Segurança  : 🚨 SEGREDO. Uso exclusivo server-side; NUNCA prefixar com
#              VITE_/PUBLIC_ nem referenciar em código client-side.
# Onde obter : https://z.ai → Menu do usuário → API Keys (manage-apikey)
#              → "Create API Key".
ZAI_API_KEY=

# Finalidade : Senha compartilhada de acesso à página /studio (o navegador
#              envia via header x-studio-token; as funções comparam com este
#              valor antes de qualquer chamada à Z.ai).
# Padrão     : defina um token forte (ex.: gerado com um gerador de senhas).
ZAI_STUDIO_TOKEN=
