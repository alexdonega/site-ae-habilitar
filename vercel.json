{
    "functions": {
        "api/*.js": {
            "maxDuration": 30
        }
    },
    "crons": [
        {
            "path": "/api/windsor-sync",
            "schedule": "10 7 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}